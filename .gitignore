# Godot 4 自动生成的导入缓存，不需要进版本库
.godot/

# 导出产物
export/
build/
*.exe
*.pck
*.zip

# 系统垃圾
Thumbs.db
desktop.ini
.DS_Store

# 原始素材投递目录（34M，不入版本库）
art/incoming/

# 工具临时目录
pip-*/
.workbuddy/

# ⚠️ 这三个是本机的东西，不进版本库。
#    `_vendor/` 曾经放着一份 1.8 GB 的第三方仓库副本（已删，需要时 git clone 回来）；
#    不加这三行的话，`git add .`（提交.bat 里就是它）会把它们一起扫进仓库。
#    ⚠️ gitignore **不支持行尾注释** —— 注释必须自己占一行，否则整行会被当成模式。
_vendor/
# 编辑器设置 + 本机 user:// 存档 / 日志
Godot/
# 聊天记录导出区（可能含隐私；里面的 README 是本机约定）
chat-export/
